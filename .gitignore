# Dependencias / build (por si quedan en la raíz)
node_modules/
.next/
out/

# Variables de entorno y secretos — NUNCA al repo
.env
.env.local
.env*.local

# Datos persistentes de n8n (docker compose)
n8n_data/

# Sistema operativo
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Basura de Word (backups automáticos y lock files del .docx)
*.docx.bak-*
~$*.docx

# Copias de respaldo de los flujos exportados de n8n. No son el artefacto: si
# entran al repo, cualquier herramienta que lea workflow/*.json termina midiendo
# o probando código viejo.
workflow/*.backup-*.json
