# Copiar a `.env.local` (gitignoreado) y completar.

# Base de los webhooks de n8n, para las llamadas desde el navegador.
# Local:      http://localhost:5678
# Producción: la URL pública de tu instancia de n8n
NEXT_PUBLIC_N8N_BASE=http://localhost:5678

# Base de n8n para las llamadas server-side (route handlers de /api/tickets).
# Opcional: si no está, se usa NEXT_PUBLIC_N8N_BASE. Sirve para apuntar al n8n
# por su red interna sin exponer esa URL al navegador.
# N8N_BASE=http://localhost:5678

# Supabase — Project URL (Settings → API → Project URL). No es secreta.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# anon / publishable key (Settings → API → anon public). No es secreta: es la
# que usa el front bajo sesión, y RLS es lo que protege los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Secreto del módulo de tickets. Tiene que ser el MISMO valor que TICKETS_API_KEY
# en el .env de n8n. Vive sólo en el servidor: el tablero habla con n8n a través
# de /api/tickets, así la key nunca llega al navegador. Vacío = módulo sin auth.
# TICKETS_API_KEY=

# Credencial de los webhooks del panel interno (cancelar pedido, resolver
# pedidos de cambio, mover el estado del trabajo). Esas acciones ya no se llaman
# directo desde el navegador: pasan por /api/crm/*, que revalida el rol admin y
# agrega este header del lado del servidor. El par nombre/valor tiene que
# coincidir con la credencial «CRM - Header Auth (panel)» de n8n.
CRM_PANEL_HEADER=x-crm-token
CRM_PANEL_TOKEN=

# service_role — sólo la usa scripts/medir-realtime.mjs para crear la fila de
# prueba. La app NO la usa: el dashboard lee con la anon key bajo sesión.
# SUPABASE_SERVICE_ROLE_KEY=

# Dirección de contacto que se ofrece en las pantallas de enlace vencido,
# ya usado o inválido de la página de aceptación. Si queda vacía, esas
# pantallas no invitan a escribir (antes lo hacían sin dar ninguna dirección).
NEXT_PUBLIC_EMAIL_CONTACTO=
