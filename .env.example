# Variables del entorno de orquestación (n8n). Copiar a `.env` al lado del
# docker-compose.yml — el `.env` real está gitignoreado.
#
#   cp .env.example .env
#
# docker-compose.yml define un default razonable para casi todas: acá sólo hace
# falta completar las que son propias de tu instalación.

# ─── n8n ─────────────────────────────────────────────────────────────────────
# URL pública con la que n8n se anuncia (ngrok o dominio). CON barra final.
N8N_PUBLIC_URL=http://localhost:5678/

# ─── CRM ─────────────────────────────────────────────────────────────────────
# Chat de Telegram al que llegan los avisos (el del bot, no el del usuario).
TELEGRAM_CHAT_ID=
# Base de Notion con las cards de leads.
NOTION_DATABASE_ID=

# URLs. Ninguna vive escrita a mano dentro de los nodos del workflow.
# FRONTEND_URL es la base de los enlaces que viajan en los mails (propuesta,
# aceptación). N8N_PUBLIC_URL (arriba) es la base del enlace de pago.
FRONTEND_URL=http://localhost:3000
RESENAS_FORM_URL=https://forms.gle/TU-FORMULARIO
GOTENBERG_URL=http://gotenberg:3000/forms/chromium/convert/html
# Orígenes que pueden llamar a los webhooks desde el navegador.
CORS_ORIGINS=http://localhost:3000,https://formulario-leads-psi.vercel.app

# Días que vale el enlace de aceptación desde que se envía la propuesta.
# Vencido, el enlace deja de aceptar/rechazar/modificar (se revalida en la base).
TOKEN_VIGENCIA_DIAS=14

# ─── Cobro con MercadoPago (RAMA 8) ───────────────────────────────────────────
# Access Token de la cuenta de MercadoPago que cobra (panel de developers →
# Tus integraciones → tu aplicación → Credenciales de producción o de prueba).
# Vacío = el link de la factura cae al modo de desarrollo (marca la factura
# como cobrada a mano, sin pasar por MercadoPago). Con un token real, el link
# pasa a ser el checkout real de MercadoPago sin tocar código.
MP_ACCESS_TOKEN=
# Moneda del cobro (currency_id de la API de MP): tiene que coincidir con el
# país de la cuenta que se use (ARS, MXN, COP, ...).
MP_CURRENCY=ARS
# Porcentaje que se reserva la plataforma sobre cada factura cobrada. No se
# transfiere sola (MercadoPago no separa el cobro entre dos cuentas): queda
# anotada en `facturas.comision_plataforma` para liquidar aparte.
MP_COMISION_PORCENTAJE=1
# Secreto para validar la firma de las notificaciones de pago (panel de
# developers → tu aplicación → Webhooks → Firma secreta). Vacío = no se
# valida la firma (no recomendado en producción).
MP_WEBHOOK_SECRET=

# ─── Calificación de leads (Tabla 4 de la tesis) ─────────────────────────────
# Los defaults reproducen exactamente la tabla documentada; están acá para poder
# recalibrar el criterio de calificación sin tocar el workflow.
# `tests/scoring.js` verifica que los defaults no cambien el resultado.
SCORING_UMBRAL_HOT=70
SCORING_UMBRAL_WARM=40
SCORING_PRESUPUESTO=5000:40,2000:30,1000:20,300:10
SCORING_URGENCIA=alta:30,media:15,baja:5
SCORING_SERVICIO=desarrollo_web:20,ecommerce:20,app_movil:18,automatizacion:18,marketing:15,seo:15,diseno_ui:15,consultoria:12,soporte:5
SCORING_BONUS_TELEFONO=5
SCORING_BONUS_DESCRIPCION=5

# ─── Validación funcional (tests/escenarios.mjs) ─────────────────────────────
# Sólo hacen falta para correr la suite de escenarios de punta a punta.
N8N_BASE=http://localhost:5678
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Header auth de los webhooks del panel interno. El mismo par nombre/valor que
# se carga en la credencial de n8n «CRM - Header Auth (panel)» y en el
# .env.local del front.
CRM_PANEL_HEADER=x-crm-token
CRM_PANEL_TOKEN=

# ─── Módulo de tickets (workflow/tickets_notion.json) ────────────────────────
# La única obligatoria: la crea `node scripts/setup-notion-tickets.mjs`.
NOTION_TICKETS_DATABASE_ID=

# Nombre del proyecto que se estampa en cada ticket. Cambiarlo es lo único que
# hace falta para reusar el mismo tablero en otro proyecto.
TICKETS_PROYECTO=CRM Freelance

# Columnas del tablero y escala de prioridades (de menor a mayor).
TICKETS_ESTADOS=BACKLOG,EN_CURSO,BLOQUEADO,HECHO
TICKETS_ESTADOS_CERRADOS=HECHO
TICKETS_ESTADO_INICIAL=BACKLOG
TICKETS_PRIORIDADES=BAJA,MEDIA,ALTA,CRITICA
TICKETS_PRIORIDAD_DEFAULT=MEDIA

# Envejecimiento: días sin movimiento que tolera cada prioridad antes de subir
# un escalón. Es lo que evita que un ticket quede en el olvido.
TICKETS_DIAS_ESCALADA=BAJA:10,MEDIA:7,ALTA:4
# Score = peso de la prioridad + puntos por día abierto (topeado en SCORE_MAX).
TICKETS_PESO_PRIORIDAD=BAJA:10,MEDIA:25,ALTA:50,CRITICA:80
TICKETS_PUNTOS_POR_DIA=2
TICKETS_SCORE_MAX=100

# Si el tablero se comparte entre proyectos, filtra por TICKETS_PROYECTO.
TICKETS_FILTRAR_POR_PROYECTO=true

# Remapeo de los nombres de las propiedades de Notion, para engancharse a una
# base que ya existe. Ejemplo: {"estado":"Status","prioridad":"Priority"}
TICKETS_PROPS={}

# Si se completa, los webhooks de tickets exigen el header `x-api-key`.
# Poner el MISMO valor en el .env.local del front (TICKETS_API_KEY).
TICKETS_API_KEY=
TICKETS_CORS_ORIGINS=*

# Chat de Telegram del módulo; vacío = usa TELEGRAM_CHAT_ID.
TICKETS_TELEGRAM_CHAT_ID=

# Enganche del CRM: al aceptarse una propuesta se siembran estos tickets.
# Filas "Titulo|PRIORIDAD|dias_hasta_vencer" separadas por ";".
# {cliente} y {servicio} se reemplazan con los datos del lead.
TICKETS_WEBHOOK_BASE=http://localhost:5678
TICKETS_PLANTILLA_PROYECTO=Kickoff con {cliente}|ALTA|2;Primera entrega de {servicio}|MEDIA|7;Revision y ajustes|MEDIA|14;Cobrar la factura de {cliente}|ALTA|10

# Dirección de contacto que se ofrece en las pantallas de enlace vencido,
# ya usado o inválido de la página de aceptación. Si queda vacía, esas
# pantallas no invitan a escribir (antes lo hacían sin dar ninguna dirección).
NEXT_PUBLIC_EMAIL_CONTACTO=
